#!/usr/bin/env perl

use strict;
use warnings;
use utf8;

use File::Basename qw( dirname );
use File::Spec     ();
use JSON::PP       ();

# Work from the design-system folder, wherever we were run from.
my $root = File::Spec->rel2abs( File::Spec->catdir( dirname(__FILE__), '..' ) );
chdir $root or die "Cannot chdir to $root: $!";

my $json   = JSON::PP->new->canonical;
my $tokens = $json->decode( slurp('tokens.json') );
my $index  = $json->decode( slurp('design-system.json') );

spew( 'tokens.css', tokens_css($tokens) );
spew( 'data.js',    data_js( $tokens, $index ) );
print "Wrote tokens.css and data.js\n";

sub tokens_css {
    my $tokens = shift;
    my $theme  = $tokens->{color}{themes}[0]{id};

    my @lines;
    for my $t ( @{ $tokens->{color}{tokens} } ) {
        push @lines, [ $t->{name}, color_value( $t->{value}, $theme ) ];
    }
    for my $t ( @{ $tokens->{shadow}{tokens} || [] } ) {
        my $v = ref $t->{value} ? $t->{value}{$theme} : $t->{value};
        push @lines, [ $t->{name}, $v ];
    }
    for my $family (qw( spacing radius layout stroke )) {
        push @lines, map { [ $_->{name}, $_->{value} ] }
            @{ $tokens->{$family}{tokens} || [] };
    }
    my $families = $tokens->{type}{families};
    push @lines, map { [ "font-$_", $families->{$_} ] } sort keys %$families;

    return join "\n",
        "/* $tokens->{name} — generated from tokens.json by bin/build. Do not edit. */",
        qq{:root, [data-theme="$theme"] \{},
        ( map {"  --$_->[0]: $_->[1];"} @lines ),
        "}", q{};
}

sub color_value {
    my ( $value, $theme ) = @_;
    $value = $value->{$theme} if ref $value;
    return $value =~ /^\{(.+)\}$/ ? "var(--$1)" : $value;
}

sub data_js {
    my ( $tokens, $index ) = @_;

    # Previews point at uploaded logos as /_blob/<id>; map those to the files.
    my ( %blob_path, @assets );
    for my $group ( @{ $index->{groups} } ) {
        my $g     = $index->{assetGroups}{$group};
        my @files = map {
            my $f    = $g->{files}{$_};
            my $path = "assets/$group/$f->{name}";
            $blob_path{ $f->{blob} } = $path;
            { name => $f->{name}, path => $path, type => $f->{type} };
        } @{ $g->{order} };
        push @assets, {
            group  => $group,
            readme => slurp_if("assets/$group/README.md"),
            files  => \@files,
        };
    }

    my ( $cover, @components );
    for my $dir ( sort glob 'components/*/' ) {
        my ($name) = $dir =~ m{components/([^/]+)/};
        my $html = slurp_if("$dir/preview.html") // next;

        $html =~ s/\A<!--\s*\@dsCard\s*(.*?)\s*-->\n?//
            or die "$dir/preview.html: no \@dsCard marker on line 1\n";
        my $marker = $1;
        my %card;
        while ( $marker =~ /(\w+)=(?:"([^"]*)"|(\S+))/g ) {
            $card{$1} = defined $2 ? $2 : $3;
        }
        $html =~ s{/_blob/([0-9a-f]+)}{
            $blob_path{$1} ? "../../$blob_path{$1}" : die "$dir: unknown blob $1\n"
        }ge;

        my $c = {
            name     => $name,
            group    => $card{group},
            subtitle => $card{subtitle},
            height   => $card{height} ? 0 + $card{height} : 120,
            width    => $card{width}  ? 0 + $card{width}  : undef,
            readme   => slurp_if("$dir/README.md"),
            preview  => $html,
        };
        $name eq 'Cover' ? ( $cover = $c ) : push @components, $c;
    }

    my $data = {
        title      => $index->{title},
        readme     => slurp('README.md'),
        tokens     => $tokens,
        assets     => \@assets,
        cover      => $cover,
        components => \@components,
    };
    return "// Generated by bin/build from the files in this folder. Do not edit.\n"
        . 'window.DESIGN_SYSTEM = '
        . JSON::PP->new->canonical->pretty->encode($data) . ";\n";
}

sub slurp {
    my $file = shift;
    open my $fh, '<:encoding(UTF-8)', $file or die "Cannot read $file: $!";
    local $/;
    return scalar <$fh>;
}

sub slurp_if {
    my $file = shift;
    return -e $file ? slurp($file) : undef;
}

sub spew {
    my ( $file, $content ) = @_;
    open my $fh, '>:encoding(UTF-8)', $file or die "Cannot write $file: $!";
    print {$fh} $content;
    close $fh or die "Cannot write $file: $!";
}

__END__

=head1 NAME

bin/build - generate tokens.css and data.js for the design system preview

=head1 SYNOPSIS

    perl design-system/bin/build

=head1 DESCRIPTION

Reads F<tokens.json>, F<design-system.json>, F<README.md> and the files under
F<components/> and F<assets/>, and writes:

=over

=item F<tokens.css>

Every token as a CSS custom property on C<:root>, which F<components/bundle.css>
and the component previews rely on.

=item F<data.js>

Everything F<index.html> renders, so the page works when opened straight from
disk (C<file://>), where it could not fetch the source files itself.

=back

Run it after changing any of those files, and commit the results.

=cut
